#!/usr/bin/env python3
"""
Flag Encoder - Display country flags using different encoding methods
User enters a country name and sees the flag encoded in:
- Binary codes
- ASCII numbers
- Unicode characters
- Keyboard symbols
- Braille characters
- Morse code
"""

import re
from typing import Dict, List, Optional

# Country to flag emoji mapping
COUNTRY_FLAGS = {
    'united states': '🇺🇸',
    'usa': '🇺🇸',
    'canada': '🇨🇦',
    'mexico': '🇲🇽',
    'france': '🇫🇷',
    'germany': '🇩🇪',
    'uk': '🇬🇧',
    'united kingdom': '🇬🇧',
    'spain': '🇪🇸',
    'italy': '🇮🇹',
    'japan': '🇯🇵',
    'china': '🇨🇳',
    'india': '🇮🇳',
    'brazil': '🇧🇷',
    'australia': '🇦🇺',
    'south korea': '🇰🇷',
    'korea': '🇰🇷',
    'russia': '🇷🇺',
